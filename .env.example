# Ejemplo de variables de entorno (Template)
# Copia este archivo y renómbralo a '.env' para definir tus credenciales locales.
# NUNCA subas el archivo '.env' a GitHub u otro control de versiones.

# Tokens para mapas (Opcional)
MAPBOX_API_KEY=tu_clave_de_mapbox_aqui

# Configuraciones de Base de Datos (Si aplica)
DB_HOST=localhost
DB_PORT=5432
DB_USER=usuario
DB_PASS=contraseña

# Parámetros del modelo/pipeline
ENTORNO=desarrollo
DEBUG_MODE=True
